#!/bin/bash

# Fetch the branch name passed from GitHub Actions (this should be passed during deployment)
BRANCH_NAME=${BRANCH_NAME:-"undefined"}

BRANCH_NAME=$(cat /var/www/hms-backend/BRANCH_NAME.txt)
echo "Deploying branch: $BRANCH_NAME"

# Docker-based deployment
if [[ "$BRANCH_NAME" == "docker-complete" ]]; then
  echo "Running Docker-based deployment..."

  cd /var/www/hms-backend/

  # Optional: stop and remove existing containers
  docker-compose down || true

  # Build and start containers
  docker-compose up -d --build

  echo "Docker deployment complete."

else
    echo "Running normal deployment for branch $BRANCH_NAME"

    # Clean up previous build and deploy new one
    sudo rm -rf /var/www/hms-backend/*
    sudo cp -r /home/ubuntu/hms-backend/* /var/www/hms-backend/

    # Run npm install and build for non-Docker branches
    cd /var/www/hms-backend/
    sudo npm install || { echo "npm install failed"; exit 1; }
    sudo npm run build || { echo "npm build failed"; exit 1; }

    # Restart or start PM2 process
    if pm2 describe HMS-BE > /dev/null; then
        echo "Restarting existing PM2 process: HMS-BE"
        pm2 restart HMS-BE
    else
        echo "Starting new PM2 process: HMS-BE"
        pm2 start dist/main.js --name HMS-BE
    fi
fi

